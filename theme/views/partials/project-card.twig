{% set image = project.meta('project_browser_image')|default(project.thumbnail) %}
<article class="project-card">
  {% if image %}<a class="project-card__image" href="{{ project.link }}" tabindex="-1" aria-hidden="true">{% include 'components/image.twig' with { image: image, size: 'large', alt: '', class: 'h-full w-full object-cover object-top' } only %}</a>{% endif %}
  <div class="flex flex-1 flex-col p-6 sm:p-8">
    {% if not generic %}<p class="eyebrow">{{ project.meta('project_client')|default('Selected work') }}</p>{% endif %}
    <h2 class="project-title {{ not generic ? 'mt-4' : '' }}"><a class="no-underline" href="{{ project.link }}">{{ project.title }}</a></h2>
    {% set summary = project.meta('project_summary')|default(project.excerpt) %}
    {% if summary %}<p class="mt-4 line-clamp-3 leading-7 text-muted">{{ summary|striptags }}</p>{% endif %}
    <a class="mt-auto inline-flex min-h-11 items-center gap-2 pt-6 font-bold text-violet-dark no-underline" href="{{ project.link }}">View project {% include 'components/icon.twig' with { name: 'arrow-right' } %}</a>
  </div>
</article>
