<div id="mobile-navigation" class="absolute inset-x-0 top-full max-h-[calc(100dvh-4.75rem)] overflow-y-auto border-b border-line bg-paper px-5 py-6 shadow-xl lg:hidden" x-show="open" x-cloak x-transition.opacity @click.outside="close()">
  <nav aria-label="Mobile navigation">
    <ul class="space-y-1">
      {% if primary_menu %}
        {% for item in primary_menu.items %}
          <li><a {% if loop.first %}x-ref="firstMobileLink"{% endif %} class="flex min-h-12 items-center border-b border-line py-3 text-xl font-bold no-underline" href="{{ item.link }}" @click="close()"{% if 'current-menu-item' in item.classes %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
        {% endfor %}
      {% else %}
        <li class="py-3 text-muted">Assign the Primary navigation menu in WordPress.</li>
      {% endif %}
    </ul>
    {% if site_settings.header_cta %}
      <div class="mt-6">{% include 'components/button.twig' with { link: site_settings.header_cta, variant: 'violet', icon: 'arrow-up-right', class: 'w-full' } %}</div>
    {% endif %}
  </nav>
</div>
