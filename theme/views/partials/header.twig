{% set settings = site_settings|default({}) %}
{% set mark = settings.site_mark_text|default('BT.') %}
{% set sticky = settings.header_sticky is not same as(false) %}

<header class="site-header {{ sticky ? 'sticky top-0' : 'relative' }} z-50 border-b border-line bg-paper/95 backdrop-blur-sm"
  x-data="{ open: false, close() { this.open = false; document.body.classList.remove('menu-open') }, toggle() { this.open = !this.open; document.body.classList.toggle('menu-open', this.open); if (this.open) this.$nextTick(() => this.$refs.firstMobileLink?.focus()) } }"
  @keydown.escape.window="close()">
  <div class="site-container flex min-h-[4.75rem] items-center justify-between gap-6 lg:min-h-[5.5rem]">
    <a class="inline-flex min-h-11 items-center text-2xl font-black tracking-[-0.06em] no-underline" href="{{ site.url }}" rel="home" aria-label="{{ site.name }} home">
      {% if settings.site_logo %}
        {% include 'components/image.twig' with { image: settings.site_logo, size: 'medium', loading: 'eager', alt: site.name, class: 'max-h-10 w-auto' } only %}
      {% else %}
        {{ mark }}
      {% endif %}
    </a>

    <nav class="hidden items-center gap-7 lg:flex" aria-label="Primary navigation">
      {% if primary_menu %}
        {% for item in primary_menu.items %}
          <a class="menu-link {{ 'current-menu-item' in item.classes ? 'is-current' : '' }}" href="{{ item.link }}"{% if 'current-menu-item' in item.classes %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {% endfor %}
      {% endif %}
    </nav>

    <div class="hidden lg:block">
      {% include 'components/button.twig' with { link: settings.header_cta, variant: 'outline', icon: 'arrow-up-right' } %}
    </div>

    <button class="grid min-h-11 min-w-11 place-items-center rounded-full border border-line-strong lg:hidden" type="button" @click="toggle()" :aria-expanded="open.toString()" aria-controls="mobile-navigation">
      <span class="sr-only" x-text="open ? 'Close menu' : 'Open menu'">Open menu</span>
      <span x-show="!open">{% include 'components/icon.twig' with { name: 'menu' } %}</span>
      <span x-show="open" x-cloak>{% include 'components/icon.twig' with { name: 'close' } %}</span>
    </button>
  </div>

  {% include 'partials/mobile-menu.twig' %}
</header>
