{% extends "base.twig" %}

{% block content %}
	{% set category = post.terms('category')|first %}

	{% include 'blocks/hero-small/index.twig' with {
		fields: {
			eyebrow: category ? category.name : 'Insight',
			heading: post.title,
			heading_highlight: '',
			supporting_text: '',
			padding_bottom: 'no-padding',
			compact_heading: true
		},
		is_preview: false,
		preview_image: null
	} only %}

	{% set featured_image = post.thumbnail %}
	{% if featured_image %}
		<div class="mt-10 lg:mt-16">
			{% include 'blocks/image-full/index.twig' with {
				fields: {
					image: {
						url: featured_image.src,
						alt: featured_image.alt
					},
					mockup: false,
					width: 'wide'
				},
				is_preview: false,
				preview_image: null
			} only %}
		</div>
	{% endif %}

	<div class="mx-auto w-[calc(100%_-_2rem)] max-w-[65ch] pt-8 lg:pt-10">
		<a class="group inline-flex items-center gap-2 body-16 font-semibold text-ink transition hover:text-ink-600" href="{{ site.url }}/insights/">
			<svg aria-hidden="true" class="h-4 w-4 transition duration-200 group-hover:-translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M19 12H5"></path><path d="m11 18-6-6 6-6"></path></svg>
			Back to insights
		</a>
	</div>

	<div data-insight-reader>
		{% include 'blocks/body-text/index.twig' with {
			fields: { content: post.content },
			is_preview: false,
			preview_image: null
		} only %}
	</div>
{% endblock %}
