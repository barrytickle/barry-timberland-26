<!doctype html>
<html {{ site.language_attributes }}>
	<head>
		<meta charset="{{ site.charset }}"/>
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<link rel="icon" type="image/png" href="{{options.favicon.url}}"/>
		<style>
			[x-cloak] {
				display: none;
			}
		</style>
		{{function('wp_head')}}

		<!-- Hotjar Tracking Code for https://www.barrytickle.com -->
		<script>
			(function(h,o,t,j,a,r){
				h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};
				h._hjSettings={hjid:613347,hjsv:6};
				a=o.getElementsByTagName('head')[0];
				r=o.createElement('script');r.async=1;
				r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;
				a.appendChild(r);
			})(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
		</script>
	</head>

	<body class="{{body_class}} bg-white text-ink" data-template="base.twig">
		<a class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-4 focus:rounded-full focus:bg-ink focus:px-6 focus:py-3 focus:text-white" href="#main">Skip to content</a>
		{% include 'header.twig' %}

		<main id="main">
			{% block content %}
				Sorry, no content
			{% endblock %}
		</main>

		{% block footer %}
			{% include 'footer.twig' %}
			{% include 'components/accessibility-menu.twig' %}
			{% include 'components/back-to-top.twig' %}
			{{ function('wp_footer') }}
		{% endblock %}
	</body>
</html>
