{% extends "base.twig" %}

{% block content %}
	{% include 'blocks/hero-small/index.twig' with {
		fields: insights_options.hero_small|default({}),
		is_preview: false,
		preview_image: null
	} only %}

	{% if insights_options.insights_group.articles|default([]) %}
		<div data-component="insights-archive-list">
			{% for article in insights_options.insights_group.articles %}
				{% include 'blocks/featured-article/index.twig' with {
					fields: article,
					is_preview: false,
					preview_image: null
				} only %}
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}
