{% extends 'base.twig' %}
{% block content %}
  <header class="site-container section-space-sm">
    {% include 'components/eyebrow.twig' with { text: 'Portfolio' } %}
    <h1 class="page-title mt-5">Selected work</h1>
    <p class="body-large mt-7 max-w-2xl text-muted">A collection of websites and digital experiences built with care, performance and real people in mind.</p>
  </header>
  <div class="site-container-wide grid gap-7 pb-24 md:grid-cols-2 lg:gap-10">
    {% for project in posts %}{% include 'partials/project-card.twig' %}{% else %}<p>No case studies have been published yet.</p>{% endfor %}
  </div>
{% endblock %}
