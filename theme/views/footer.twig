{% set logo_text_highlight = options.logo_text_highlight|default('show') %}
{% set logo_text = options.logo_text|default('casy.') %}
{% set footer_tagline = options.footer_tagline|default('A stunning digital designer portfolio website template for you.') %}
{% set social_links = options.social_links|default([
	{ label: 'Instagram', url: '#' },
	{ label: 'Behance', url: '#' },
	{ label: 'Twitter', url: '#' },
	{ label: 'Dribbble', url: '#' }
]) %}
{% set default_column_1_links = [
	{ url: { title: 'Home', url: site.url, target: '' } },
	{ url: { title: 'About', url: site.url ~ '/about/', target: '' } },
	{ url: { title: 'Works', url: site.url ~ '/works/', target: '' } },
	{ url: { title: 'Insights', url: site.url ~ '/blog/', target: '' } },
	{ url: { title: 'Contact', url: site.url ~ '/contact/', target: '' } }
] %}

{% set footer_title = options.footer_link_title|default('Page List') %}
{% set footer_links = options.footer_links|default(default_column_1_links) %}
{% set newsletter_heading = options.newsletter_heading|default('Stay connected w/ me.') %}

{% set copyright_text = options.copyright_text|default('©' ~ ("now"|date("Y")) ~ ' ' ~ site.name ~ '. All rights reserved.') %}

{% set heading = options.heading|default("Want to create something") %}
{% set heading_highlight = options.heading_highlight|default("awesome?") %}
{% set cta = options.cta_link|default({ url: site.url ~ '/contact/', title: 'Let’s Talk' }) %}

{% if footer_links is defined and footer_links|length > 4 %}
  {% set columns = [] %}
  {% for i in 0..((footer_links|length - 1) // 4) %}
    {% set columns = columns|merge([footer_links|slice(i * 4, 4)]) %}
  {% endfor %}
{% else %}
  {% set columns = [footer_links] %}
{% endif %}


<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="cta-light">
	<div class="rounded-3xl bg-ink-200/70 px-8 py-20 text-center">
		<h2 class="h2 mx-auto max-w-3xl">{{ heading }} <span class="text-ink-400">{{ heading_highlight }}</span></h2>
		<div class="mt-10 flex justify-center">
			{% include 'components/button.twig' with { href: cta.url, label: cta.title, target: cta.target, variant: 'filled', size: 'lg' } %}
		</div>
	</div>
</section>


<footer class="bg-ink px-6 pb-10 pt-16 text-white lg:px-[72px]" data-component="footer">
	<div class="mx-auto max-w-[1200px]">
		<span class="text-3xl font-semibold tracking-tightest">
			<span class="text-ink-500">{{logo_text_highlight}}</span>{{logo_text}}
		</span>

		<p class="body-18 mt-5 max-w-md text-ink-300">
			{{footer_tagline}}
		</p>

		<div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4">
			{% for social in social_links %}<a target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink-700 py-4 text-center body-16 font-medium transition hover:border-white" href="{{ social.url }}">{{ social.label }}</a>{% endfor %}
		</div>

		<div class="mt-14">
				<p class="body-18 mb-6 font-semibold text-ink-400">{{footer_title}}</p>

				<div class="flex gap-16">
					{% for column in columns %}
						<div class="flex flex-col gap-2">
							{% for item in column %}
								{% if item.url.url %}
									<a class="text-ink-200 hover:text-white" href="{{ item.url.url }}"{% if item.url.target %} target="{{ item.url.target }}"{% endif %}{% if item.url.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{{ item.url.title }}</a>
								{% endif %}
							{% endfor %}
						</div>
					{% endfor %}
				</div>
			</div>

		<p class="mt-14 border-t border-ink-800 pt-8 text-center body-14 text-ink-500">
			{{copyright_text}}
		</p>
	</div>
</footer>
