{% set logo_text_highlight = options.logo_text_highlight|default('show') %}
{% set logo_text = options.logo_text|default('casy.') %}
{% set footer_tagline = options.footer_tagline|default('A stunning digital designer portfolio website template for you.') %}
{% set social_links = options.social_links|default([
	{ label: 'Instagram', url: '#' },
	{ label: 'Behance', url: '#' },
	{ label: 'Twitter', url: '#' },
	{ label: 'Dribbble', url: '#' }
]) %}
{% set default_explore_links = [
	{ url: { title: 'Home', url: site.url, target: '' } },
	{ url: { title: 'About', url: site.url ~ '/about/', target: '' } },
	{ url: { title: 'Projects', url: site.url ~ '/projects/', target: '' } },
	{ url: { title: 'Contact', url: site.url ~ '/contact/', target: '' } }
] %}
{% set default_writing_links = [
	{ url: { title: 'Insights', url: site.url ~ '/insights/', target: '' } },
	{ url: { title: 'Journal', url: site.url ~ '/journal/', target: '' } }
] %}
{% set default_policy_links = [] %}
{% set privacy_policy_url = function('get_privacy_policy_url') %}
{% if privacy_policy_url %}
	{% set default_policy_links = default_policy_links|merge([
		{ url: { title: 'Privacy Policy', url: privacy_policy_url, target: '' } }
	]) %}
{% endif %}

{% set explore_title = options.footer_link_title|default('Explore') %}
{% set source_explore_links = options.footer_links|default(default_explore_links) %}
{% set writing_title = options.footer_writing_title|default('Writing') %}
{% set writing_links = options.footer_writing_links|default([]) %}
{% set policy_title = options.footer_policy_title|default('Policies') %}
{% set policy_links = options.footer_policy_links|default([]) %}
{% set social_title = options.footer_social_title|default('Elsewhere') %}

{# Keep existing Footer Links useful after this upgrade: writing and policy URLs
   are displayed in their new columns until those repeaters are populated. #}
{% if not writing_links %}
	{% for item in source_explore_links %}
		{% set item_url = item.url.url|default('') %}
		{% if '/insights' in item_url or '/journal' in item_url or '/blog' in item_url %}
			{% set writing_links = writing_links|merge([item]) %}
		{% endif %}
	{% endfor %}
{% endif %}
{% if not writing_links %}{% set writing_links = default_writing_links %}{% endif %}

{% if not policy_links %}
	{% for item in source_explore_links %}
		{% set item_url = item.url.url|default('') %}
		{% if '/privacy' in item_url or '/cookie' in item_url or '/terms' in item_url or '/policy' in item_url %}
			{% set policy_links = policy_links|merge([item]) %}
		{% endif %}
	{% endfor %}
{% endif %}
{% if not policy_links %}{% set policy_links = default_policy_links %}{% endif %}

{% set explore_links = [] %}
{% for item in source_explore_links %}
	{% set item_url = item.url.url|default('') %}
	{% set is_writing = '/insights' in item_url or '/journal' in item_url or '/blog' in item_url %}
	{% set is_policy = '/privacy' in item_url or '/cookie' in item_url or '/terms' in item_url or '/policy' in item_url %}
	{% if not is_writing and not is_policy %}
		{% set explore_links = explore_links|merge([item]) %}
	{% endif %}
{% endfor %}

{% set copyright_text = options.copyright_text|default('©' ~ ("now"|date("Y")) ~ ' ' ~ site.name ~ '. All rights reserved.') %}

{% set heading = options.heading|default("Want to create something") %}
{% set heading_highlight = options.heading_highlight|default("awesome?") %}
{% set cta = options.cta_link|default({ url: site.url ~ '/contact/', title: 'Let’s Talk' }) %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="cta-light">
	<div class="rounded-3xl bg-ink-200/70 px-8 py-20 text-center">
		<h2 class="h2 mx-auto max-w-3xl">{{ heading }} <span class="text-ink-400">{{ heading_highlight }}</span></h2>
		<div class="mt-10 flex justify-center">
			{% include 'components/button.twig' with { href: cta.url, label: cta.title, target: cta.target, variant: 'filled', size: 'lg' } %}
		</div>
	</div>
</section>


<footer class="bg-ink px-6 pb-10 pt-16 text-white lg:px-[72px]" data-component="footer">
	<div class="mx-auto max-w-[1200px]">
		<div class="grid gap-12 border-b border-ink-800 pb-14 lg:grid-cols-[1.1fr_2fr] lg:gap-20">
			<div>
				<span class="text-3xl font-semibold tracking-tightest">
					<span class="text-ink-500">{{logo_text_highlight}}</span>{{logo_text}}
				</span>

				<p class="body-18 mt-5 max-w-md text-ink-300">{{footer_tagline}}</p>
			</div>

			<div class="grid grid-cols-2 gap-x-8 gap-y-10 sm:grid-cols-3">
				<nav aria-label="{{ explore_title }}">
					<p class="body-14 mb-4 font-semibold uppercase tracking-wide text-ink-500">{{ explore_title }}</p>
					<div class="flex flex-col items-start gap-3">
						{% for item in explore_links %}
							{% if item.url.url %}<a class="body-16 text-ink-200 transition hover:text-white" href="{{ item.url.url }}"{% if item.url.target %} target="{{ item.url.target }}"{% endif %}{% if item.url.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{{ item.url.title }}</a>{% endif %}
						{% endfor %}
					</div>
				</nav>

				<nav aria-label="{{ writing_title }}">
					<p class="body-14 mb-4 font-semibold uppercase tracking-wide text-ink-500">{{ writing_title }}</p>
					<div class="flex flex-col items-start gap-3">
						{% for item in writing_links %}
							{% if item.url.url %}<a class="group inline-flex items-center gap-2 body-16 font-semibold text-white" href="{{ item.url.url }}"{% if item.url.target %} target="{{ item.url.target }}"{% endif %}{% if item.url.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{{ item.url.title }}<svg class="h-4 w-4 transition duration-200 group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a>{% endif %}
						{% endfor %}
					</div>
				</nav>

				{% if policy_links %}
					<nav class="col-span-2 sm:col-span-1" aria-label="{{ policy_title }}">
						<p class="body-14 mb-4 font-semibold uppercase tracking-wide text-ink-500">{{ policy_title }}</p>
						<div class="flex flex-col items-start gap-3">
							{% for item in policy_links %}
								{% if item.url.url %}<a class="body-16 text-ink-300 transition hover:text-white" href="{{ item.url.url }}"{% if item.url.target %} target="{{ item.url.target }}"{% endif %}{% if item.url.target == '_blank' %} rel="noopener noreferrer"{% endif %}>{{ item.url.title }}</a>{% endif %}
							{% endfor %}
						</div>
					</nav>
				{% endif %}
			</div>
		</div>

		{% if social_links %}
			<div class="mt-10">
				<p class="body-14 mb-4 font-semibold uppercase tracking-wide text-ink-500">{{ social_title }}</p>
				<div class="flex flex-wrap gap-3">
					{% for social in social_links %}<a target="_blank" rel="noopener noreferrer" class="rounded-full border border-ink-700 px-5 py-2.5 body-14 font-medium text-ink-200 transition hover:border-white hover:text-white" href="{{ social.url }}">{{ social.label }}</a>{% endfor %}
				</div>
			</div>
		{% endif %}

		<p class="mt-10 text-center body-14 text-ink-500">
			{{copyright_text}}
		</p>
	</div>
</footer>
