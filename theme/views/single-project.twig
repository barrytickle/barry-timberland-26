{% extends "base.twig" %}

{% block content %}
	<div class="max-w-screen-xl mx-auto content-page">
		{{ processed_content|raw }}
	</div>

	{% set all_projects = get_posts({ 'post_type': 'project', 'posts_per_page': -1, 'orderby': 'date', 'order': 'DESC' }) %}
	{% set total = all_projects|length %}
	{% set current_index = 0 %}
	{% for project in all_projects %}
		{% if project.ID == post.ID %}
			{% set current_index = loop.index0 %}
		{% endif %}
	{% endfor %}
	{% set prev_project = all_projects[(current_index - 1 + total) % total] %}
	{% set next_project = all_projects[(current_index + 1) % total] %}

	{% if total > 1 %}
	<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]">
		<div class="mb-12 flex flex-wrap items-center justify-between gap-4" data-component="section-header">
			<h2 class="h3">More Projects</h2>
			<a class="group inline-flex items-center gap-2.5 rounded-full border border-ink px-6 py-3.5 body-16 font-semibold text-ink transition hover:bg-ink hover:text-white" href="{{ site.url }}/projects/">
				All Works
				<svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
			</a>
		</div>
		<div class="grid gap-x-8 gap-y-14 sm:grid-cols-2">
			{% for project in [prev_project, next_project] %}
				{% set category = project.terms('project_category')|first %}
				{% include 'components/work-card.twig' with { title: project.title, category: category ? category.name : '', href: project.link, image: project.thumbnail ? project.thumbnail.src : null } %}
			{% endfor %}
		</div>
	</section>
	{% endif %}
{% endblock %}
