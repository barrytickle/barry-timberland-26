{% set logo_text_highlight = options.logo_text_highlight|default('show') %}
{% set logo_text = options.logo_text|default('casy.') %}
{% set fallback_links = [
	{ label: 'About Me', url: site.url ~ '/about-me/' },
	{ label: 'Services', url: site.url ~ '/services/' },
	{ label: 'Locations', url: '#', children: [
		{ label: 'Telford', url: site.url ~ '/web-developer-telford/' },
		{ label: 'Shrewsbury', url: site.url ~ '/web-developer-shrewsbury/' },
		{ label: 'Oswestry', url: site.url ~ '/web-developer-oswestry/' }
	] },
	{ label: 'Projects', url: site.url ~ '/projects/' },
	{ label: 'Blog', url: '#', children: [
		{ label: 'Lifestyle', url: site.url ~ '/journal/' },
		{ label: 'Insights', url: site.url ~ '/insights/' }
	] },
	{ label: 'Contact Me', url: site.url ~ '/contact-me/' }
] %}
{% set cta = options.header_cta|default({ url: site.url ~ '/contact/', title: 'Let’s Talk' }) %}
{% set social_links = options.social_links|default([
	{ label: 'Instagram', url: '#' },
	{ label: 'Behance', url: '#' },
	{ label: 'Twitter', url: '#' },
	{ label: 'Dribbble', url: '#' }
]) %}

<div class="navbar-shell" data-component="navbar-shell">
<header class="site-navbar z-40 bg-white/85 backdrop-blur" data-component="navbar" id="navbar">
	<div class="mx-auto flex max-w-[1200px] items-center justify-between px-6 py-5 lg:px-[72px]">
		<a class="text-2xl font-semibold tracking-tightest text-ink" href="{{ site.url }}"><span class="text-ink-400">{{ logo_text_highlight }}</span>{{ logo_text }}</a>
		<nav class="hidden items-center gap-5 body-14 font-medium lg:flex" aria-label="Primary navigation">
			{% set menu_items = (header_menu and header_menu.items) ? header_menu.items : fallback_links %}
			{% for item in menu_items %}
				{% set item_url = item.link|default(item.url)|replace({'http://www.barrytickle.com': 'https://www.barrytickle.com'}) %}
				{% set item_label = item.title|default(item.label) %}
				{% set children = item.children|default([]) %}
				{% set is_active = item.current|default(false) or item.current_item_ancestor|default(false) or (not children and check_url_match(item_url)) %}
				{% if children %}
					<div class="relative" data-nav-dropdown>
						<button class="inline-flex items-center gap-1.5 py-3 transition {{ is_active ? 'font-semibold text-ink underline decoration-ink underline-offset-4' : 'text-ink-600 hover:text-ink' }}" type="button" aria-expanded="false" aria-controls="nav-dropdown-{{ loop.index }}" data-nav-dropdown-button>
							{{ item_label }}
							<svg aria-hidden="true" class="h-3.5 w-3.5 transition-transform" data-nav-chevron fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
						</button>
						<div class="absolute left-1/2 top-full hidden min-w-52 -translate-x-1/2 pt-2" id="nav-dropdown-{{ loop.index }}" data-nav-dropdown-menu>
							<div class="rounded-2xl border border-ink-200 bg-white p-2 shadow-[0_1rem_3rem_rgb(3_7_18/0.14)]">
								{% for child in children %}
									{% set child_url = child.link|default(child.url)|replace({'http://www.barrytickle.com': 'https://www.barrytickle.com'}) %}
									{% set child_active = child.current|default(false) or check_url_match(child_url) %}
									<a class="block rounded-xl px-4 py-3 transition {{ child_active ? 'bg-ink-100 font-semibold text-ink' : 'text-ink-600 hover:bg-ink-100 hover:text-ink' }}" href="{{ child_url }}"{% if child_active %} aria-current="page"{% endif %}>{{ child.title|default(child.label) }}</a>
								{% endfor %}
							</div>
						</div>
					</div>
				{% else %}
					<a class="py-3 transition {{ is_active ? 'font-semibold text-ink underline decoration-ink underline-offset-4' : 'text-ink-600 hover:text-ink' }}" href="{{ item_url }}"{% if is_active %} aria-current="page"{% endif %}>{{ item_label }}</a>
				{% endif %}
			{% endfor %}
		</nav>
		<div class="flex items-center gap-3">
			<a class="group hidden items-center gap-2.5 rounded-full border border-ink px-6 py-3.5 body-16 font-semibold text-ink transition duration-200 hover:bg-ink hover:text-white sm:inline-flex" href="{{ cta.url }}"{% if cta.target %} target="{{ cta.target }}"{% endif %}>
				{{ cta.title }}
				<svg class="h-4 w-4 transition duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
			</a>
			<button aria-label="Open menu" aria-controls="mobile-menu" aria-expanded="false" class="grid h-[52px] w-[52px] place-items-center rounded-full border border-ink text-ink transition duration-200 hover:bg-ink hover:text-white lg:hidden" data-component="mobile-menu-open" type="button">
				<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24"><path d="M4 8h16M4 16h16"></path></svg>
			</button>
		</div>
	</div>
</header>
</div>

<div class="fixed inset-0 z-50 hidden overflow-y-auto bg-ink px-6 py-10 text-white lg:hidden" data-component="mobile-menu" id="mobile-menu">
	<div class="mx-auto max-w-[1200px]">
		<div class="flex items-center justify-between border-b border-ink-800 pb-8">
			<a class="text-2xl font-semibold tracking-tightest" href="{{ site.url }}"><span class="text-ink-500">{{ logo_text_highlight }}</span>{{ logo_text }}</a>
			<button aria-label="Close menu" class="grid h-12 w-12 place-items-center rounded-full border border-ink-700 transition duration-200 hover:border-white" data-component="mobile-menu-close" type="button">
				<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"></path></svg>
			</button>
		</div>
		<nav class="divide-y divide-ink-800" aria-label="Mobile navigation">
			{% set menu_items = (header_menu and header_menu.items) ? header_menu.items : fallback_links %}
			{% for item in menu_items %}
				{% set item_url = item.link|default(item.url)|replace({'http://www.barrytickle.com': 'https://www.barrytickle.com'}) %}
				{% set item_label = item.title|default(item.label) %}
				{% set children = item.children|default([]) %}
				{% set is_active = check_url_match(item_url) %}
				{% if children %}
					<div data-mobile-submenu>
						<button class="flex w-full items-center justify-between py-6 text-left" type="button" aria-expanded="false" aria-controls="mobile-submenu-{{ loop.index }}" data-mobile-submenu-button>
							<span class="h2 text-white">{{ item_label }} <span class="h6 align-top text-ink-500">({{ '%02d'|format(loop.index) }})</span></span>
							<span class="grid h-14 w-16 place-items-center rounded-full border border-ink-700">
								<svg aria-hidden="true" class="h-5 w-5 transition-transform" data-mobile-chevron fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"></path></svg>
							</span>
						</button>
						<div class="hidden pb-6 pl-4" id="mobile-submenu-{{ loop.index }}" data-mobile-submenu-panel>
							{% for child in children %}
								{% set child_url = child.link|default(child.url)|replace({'http://www.barrytickle.com': 'https://www.barrytickle.com'}) %}
								<a class="flex items-center justify-between border-t border-ink-800 py-4 body-18 font-semibold text-ink-200 hover:text-white" href="{{ child_url }}">
									{{ child.title|default(child.label) }}
									<svg aria-hidden="true" class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
								</a>
							{% endfor %}
						</div>
					</div>
				{% else %}
					<a class="group flex items-center justify-between py-6" href="{{ item_url }}"{% if is_active %} aria-current="page"{% endif %}>
						<span class="h2 {{ is_active ? 'text-white underline decoration-white underline-offset-8' : 'text-white' }}">{{ item_label }} <span class="h6 align-top text-ink-500">({{ '%02d'|format(loop.index) }})</span></span>
						<span class="grid h-16 w-20 place-items-center rounded-full border border-ink-700 transition duration-200 group-hover:bg-white group-hover:text-ink">
							<svg class="h-5 w-5 transition duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
						</span>
					</a>
				{% endif %}
			{% endfor %}
		</nav>
		{% if cta.url and cta.title %}
			<a class="group mt-8 flex w-full items-center justify-between rounded-full bg-white px-6 py-4 body-18 font-semibold text-ink transition duration-200 hover:bg-ink-200" href="{{ cta.url }}"{% if cta.target %} target="{{ cta.target }}"{% endif %}{% if cta.target == '_blank' %} rel="noopener noreferrer"{% endif %}>
				{{ cta.title }}
				<svg class="h-5 w-5 transition duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
			</a>
		{% endif %}
		<div class="mt-10 border-t border-ink-800 pt-8">
			<div>
				<p class="body-18 mb-4 font-semibold text-ink-400">Follow me.</p>
				<div class="flex flex-wrap gap-6 body-16 font-medium">
					{% for social in social_links %}<a class="inline-flex items-center gap-1.5 hover:text-ink-300" href="{{ social.url }}">{{ social.label|upper }} <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg></a>{% endfor %}
				</div>
			</div>
		</div>
	</div>
</div>
