{#
  Reusable button/link, converted from the Showcasy UI kit's buttons.html.

  Params:
    href     - url (required unless variant is 'filter')
    label    - text
    variant  - filled (default) | outlined | text | icon | filter
    size     - lg | md (default) | sm
    icon     - show trailing arrow icon (default true, ignored for variant=text/filter which have their own rules)
    active   - bool, only used for variant=filter
    target   - optional link target
#}
{% set size = size|default('md') %}
{% set variant = variant|default('filled') %}
{% set show_icon = icon is not defined or icon %}

{% set arrow %}<svg class="h-4 w-4 transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>{% endset %}

{% if variant == 'filter' %}
  <button type="button" class="rounded-full border px-5 py-2.5 body-14 font-medium transition {{ active|default(false) ? 'border-ink-400 bg-ink-200 text-ink' : 'border-ink-200 bg-white text-ink-600 hover:border-ink-400' }}">{{ label }}</button>

{% elseif variant == 'text' %}
  <a class="group inline-flex items-center gap-2 body-16 font-semibold text-ink" href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}>{{ label }} {{ arrow }}</a>

{% elseif variant == 'icon' %}
  {% set icon_size = size == 'lg' ? 'h-[74px] w-[110px]' : (size == 'sm' ? 'h-12 w-16' : 'h-14 w-[84px]') %}
  <a aria-label="{{ label|default('Continue') }}" class="group grid {{ icon_size }} place-items-center rounded-full border border-ink text-ink transition hover:bg-ink hover:text-white" href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}>{{ arrow }}</a>

{% else %}
  {% set pad = size == 'lg' ? 'px-8 py-5 body-18 gap-3' : (size == 'sm' ? 'px-5 py-3 body-14 gap-2' : 'px-7 py-4 body-16 gap-2.5') %}
  {% set colours = variant == 'outlined' ? 'border border-ink text-ink hover:bg-ink hover:text-white' : 'bg-ink text-white hover:bg-ink-800' %}
  <a class="group inline-flex items-center {{ pad }} rounded-full font-semibold transition {{ colours }}" href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}>{{ label }}{% if show_icon %} {{ arrow }}{% endif %}</a>
{% endif %}
