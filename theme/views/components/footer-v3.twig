{#
  Alternate footer treatment — minimal single-row nav, no logo, no Page List.
  Converted from Showcasy UI kit: home-v3.html footer-v3-section.
  Reference/alternate component — the live site uses footer.twig ("footer-v1"). Not wired into base.twig.
  Pulls from the same ACF options-page fields as footer.twig so content stays in sync if swapped in later.
#}
{% set fallback_links = [
	{ label: 'Home', url: site.url },
	{ label: 'About', url: site.url ~ '/about/' },
	{ label: 'Works', url: site.url ~ '/works/' },
	{ label: 'Insights', url: site.url ~ '/blog/' }
] %}
{% set footer_links = options.footer_links|default(fallback_links) %}
{% set social_links = options.social_links|default([
	{ label: 'Instagram', url: '#' },
	{ label: 'Behance', url: '#' },
	{ label: 'Twitter', url: '#' },
	{ label: 'Dribbble', url: '#' }
]) %}
{% set newsletter_heading = 'Keep up with me if you can.' %}
{% set copyright_text = options.copyright_text|default('©' ~ ("now"|date("Y")) ~ ' ' ~ site.name ~ '. All rights reserved.') %}

<footer class="bg-ink px-6 pb-10 pt-10 text-white lg:px-[72px]" data-component="footer-v3">
	<div class="mx-auto max-w-[1200px]">
		<div class="flex flex-col items-center gap-6 border-b border-ink-800 pb-10 sm:flex-row sm:justify-between">
			<nav class="flex flex-wrap items-center gap-6 body-16 font-medium" aria-label="Footer navigation">
				{% for link in footer_links %}
					<a class="text-ink-200 underline underline-offset-4 hover:text-white" href="{{ link.url }}">{{ link.label|upper }}</a>
				{% endfor %}
			</nav>
			<div class="flex gap-3">
				{% for social in social_links %}
					<a aria-label="{{ social.label }}" class="grid h-10 w-10 place-items-center rounded-full border border-ink-700 transition duration-200 hover:border-white" href="{{ social.url }}">
						<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
					</a>
				{% endfor %}
			</div>
		</div>

		<div class="flex flex-col items-center gap-8 pt-10 text-center">
			<div class="w-full max-w-sm">
				<p class="body-18 mb-4 font-semibold text-ink-400">{{ newsletter_heading }}</p>
				<form class="relative" method="post" action="">
					<input class="w-full border-0 border-b border-ink-700 bg-transparent py-3 pr-10 text-center body-16 text-white placeholder:text-ink-500 focus:border-white focus:outline-none focus:ring-0" placeholder="Enter your email" type="email" name="email"/>
					<button aria-label="Subscribe" type="submit" class="absolute right-0 top-1/2 -translate-y-1/2 text-white">
						<svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
					</button>
				</form>
			</div>
			<p class="body-14 text-ink-500">{{ copyright_text }}</p>
		</div>
	</div>
</footer>
