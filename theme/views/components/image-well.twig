{#
  Image well with optional MacBook mockup.

  Params:
    image            - ACF image array or null
    alt              - alt text when image is a plain URL string
    logo             - optional text logo, shown instead of image/mockup
    mockup           - bool, show inside a MacBook frame on bg-ink-200/70
    aspect           - Tailwind aspect class when not in mockup mode (default: aspect-[16/9])
    mockup_max_width - max width class for the MacBook frame (default: max-w-[900px])
#}
{% set aspect = aspect|default('aspect-[16/9]') %}
{% set mockup_max_width = mockup_max_width|default('max-w-[900px]') %}
{% set shadow = shadow|default(false) %}

{% if logo %}
	<div class="grid aspect-square place-items-center overflow-hidden rounded-card bg-ink-200/70 {{shadow ? 'shadow-lg' : ''}}">
		<span class="px-6 text-center text-3xl font-bold tracking-tight text-ink-700 sm:text-4xl">{{ logo }}</span>
	</div>
{% elseif mockup %}
	<div class="grid place-items-center overflow-hidden rounded-card bg-ink-200/70 px-6 py-12">
		{% include 'components/macbook-mockup.twig' with { image: image, alt: alt, max_width: mockup_max_width } %}
	</div>
{% else %}
	<div class="grid {{ aspect }} place-items-center overflow-hidden rounded-card bg-muted {{shadow ? 'shadow-lg' : ''}}">
		{% if image %}
			<img class="h-full w-full object-cover" src="{{ image.url }}" alt="{{ image.alt }}">
		{% else %}
			<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
		{% endif %}
	</div>
{% endif %}
