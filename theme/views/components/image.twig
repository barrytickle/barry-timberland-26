{% if image %}
  {% set attachment_id = image.ID|default(image.id|default(image)) %}
  {% set alt_text = alt is defined ? alt : image.alt|default('') %}
  {{ function('wp_get_attachment_image', attachment_id, size|default('large'), false, {
    class: class|default(''),
    alt: alt_text,
    loading: loading|default('lazy'),
    decoding: 'async',
    fetchpriority: fetchpriority|default('auto')
  })|raw }}
{% elseif is_preview %}
  <div class="grid aspect-video place-items-center bg-violet-soft p-8 text-center text-sm font-semibold text-muted">Choose an image to complete this block.</div>
{% endif %}
