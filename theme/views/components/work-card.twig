{# Converted from Showcasy UI kit: components/work-card.html
   Params: title, category, href, image (optional — falls back to the placeholder well) #}
<a class="group block" data-component="work-card" href="{{ href|default('#') }}" data-filter="{{to_snake_case(category)}}">
	<div class="mb-6 grid aspect-[16/11] place-items-center overflow-hidden rounded-card bg-muted">
		{% if image %}
			<img class="h-full w-full object-cover" src="{{ image }}" alt="{{ title|default('') }}">
		{% else %}
			<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
		{% endif %}
	</div>
	<div class="flex items-center justify-between">
		<div>
			<h3 class="h6">{{ title }}</h3>
			<p class="body-16 mt-1 text-ink-500">{{ category }}</p>
		</div>
		<span class="grid h-14 w-14 shrink-0 place-items-center rounded-full border border-ink text-ink transition duration-200 group-hover:bg-ink group-hover:text-white">
			<svg class="h-4 w-4 transition duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg>
		</span>
	</div>
</a>
