<div class="accessibility-menu" data-accessibility-menu>
	<div class="accessibility-menu__panel" id="accessibility-menu-panel" data-accessibility-panel hidden>
		<p class="accessibility-menu__title">Accessibility</p>
		<button class="accessibility-menu__option" type="button" role="switch" aria-checked="false" data-readability-toggle>
			<span>
				<strong>Readability mode</strong>
				<small>Warmer background and darker text</small>
			</span>
			<span class="accessibility-menu__switch" aria-hidden="true"></span>
		</button>
		<button class="accessibility-menu__option" type="button" role="switch" aria-checked="false" data-dark-theme-toggle>
			<span>
				<strong>Dark theme</strong>
				<small>Darker surfaces with lighter text</small>
			</span>
			<span class="accessibility-menu__switch" aria-hidden="true"></span>
		</button>
	</div>

	<button class="accessibility-menu__trigger" type="button" aria-label="Open accessibility options" aria-controls="accessibility-menu-panel" aria-expanded="false" data-accessibility-trigger>
		<svg aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
			<circle cx="12" cy="4.5" r="2"></circle>
			<path d="M5 8.5h14M12 7v13M8.5 20l3.5-7 3.5 7"></path>
		</svg>
		<span>Accessibility</span>
	</button>
</div>
