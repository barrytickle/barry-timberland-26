{% extends 'base.twig' %}
{% block content %}
  <header class="site-container section-space-sm">
    {% include 'components/eyebrow.twig' with { text: title|default('Journal') } %}
    <h1 class="page-title mt-5">{{ title|default(site.name) }}</h1>
  </header>
  <div class="site-container grid gap-7 pb-24 md:grid-cols-2 lg:grid-cols-3">
    {% for post in posts %}{% include 'partials/project-card.twig' with { project: post, generic: true } %}{% else %}<p>No posts found.</p>{% endfor %}
  </div>
{% endblock %}
