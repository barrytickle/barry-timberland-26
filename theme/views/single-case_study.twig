{% extends 'base.twig' %}
{% block content %}
  <article>
    <header class="site-container section-space-sm">
      {% include 'components/eyebrow.twig' with { text: post.meta('project_client')|default('Case study') } %}
      <h1 class="page-title mt-6">{{ post.title }}</h1>
      {% if post.meta('project_summary') %}<p class="body-large mt-7 max-w-3xl text-muted">{{ post.meta('project_summary') }}</p>{% endif %}
      <dl class="mt-10 grid gap-5 border-y border-line py-6 sm:grid-cols-3">
        {% if post.meta('project_year') %}<div><dt class="text-xs font-extrabold uppercase tracking-widest text-muted">Year</dt><dd class="mt-2 font-semibold">{{ post.meta('project_year') }}</dd></div>{% endif %}
        {% if post.meta('project_services') %}<div><dt class="text-xs font-extrabold uppercase tracking-widest text-muted">Services</dt><dd class="mt-2 font-semibold">{{ post.meta('project_services') }}</dd></div>{% endif %}
        {% if post.meta('project_technologies') %}<div><dt class="text-xs font-extrabold uppercase tracking-widest text-muted">Technology</dt><dd class="mt-2 font-semibold">{{ post.meta('project_technologies') }}</dd></div>{% endif %}
      </dl>
    </header>

    {% if post.meta('project_browser_image') %}
      <div class="site-container-wide pb-16">{% include 'components/browser-frame.twig' with { image: post.meta('project_browser_image'), alt: post.meta('project_browser_image').alt|default(post.title ~ ' website'), label: post.meta('project_client'), loading: 'eager', fetchpriority: 'high' } %}</div>
    {% endif %}

    <div class="site-container pb-24">
      <div class="rich-text max-w-3xl">{{ post.content|raw }}</div>
      {% if post.meta('project_outcome') %}<aside class="mt-14 max-w-3xl border-l-4 border-violet bg-violet-soft p-7"><h2 class="text-xl font-bold">Outcome</h2><div class="rich-text mt-3">{{ post.meta('project_outcome')|raw }}</div></aside>{% endif %}
      {% if post.meta('project_url') %}<div class="mt-10">{% include 'components/button.twig' with { link: { url: post.meta('project_url'), title: 'Visit project' }, variant: 'outline', icon: 'arrow-up-right' } %}</div>{% endif %}
    </div>
  </article>
{% endblock %}
