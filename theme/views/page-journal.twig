{% extends "base.twig" %}

{% block content %}
	{% include 'components/breadcrumbs.twig' with { trail: breadcrumb_trail } %}
	{% include 'blocks/hero-small/index.twig' with {
		fields: {
			eyebrow: 'Journal',
			heading: 'Life outside the code editor.',
			heading_highlight: '',
			supporting_text: 'Personal stories, days out and the occasional detour away from WordPress and conversion rates.'
		},
		is_preview: false,
		preview_image: null
	} only %}

	<section class="mx-auto max-w-[1200px] px-6 pb-16 lg:px-[72px] lg:pb-24" data-component="journal-grid">
		<div class="mb-10 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-end">
			<div>
				<p class="body-14 font-semibold uppercase tracking-[0.12em] text-ink-500">Personal writing</p>
				<h2 class="h5 mt-2">Latest from the journal</h2>
			</div>
			<a class="body-16 font-semibold text-ink underline underline-offset-4" href="{{ site.url }}/insights/">View professional insights</a>
		</div>

		{% if journal_posts %}
			<div class="grid gap-x-7 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
				{% for article in journal_posts %}
					{% include 'components/blog-card.twig' with {
						eyebrow: article.date,
						title: article.title,
						excerpt: article.excerpt,
						href: article.url,
						image: article.image
					} only %}
				{% endfor %}
			</div>
		{% else %}
			<p class="body-18 text-ink-500">No journal entries yet.</p>
		{% endif %}
	</section>
{% endblock %}
