{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}

{% set eyebrow = fields.eyebrow %}
{% set heading = fields.heading %}
{% set heading_highlight = fields.heading_highlight %}
{% set supporting_text = fields.supporting_text %}
{% set padding_bottom = fields.padding_bottom == 'no-padding' ? 'pb-0' : 'pb-8' %}
{% set heading_class = fields.compact_heading|default(false) ? 'h2' : 'h1' %}

<section class="mx-auto max-w-[1200px] px-6 {{ padding_bottom }} pt-10 lg:px-[72px] lg:pt-16" data-component="hero-small">
<p class="body-22 mb-6 text-ink-700">{{ eyebrow }}</p>
<h1 class="{{ heading_class }} max-w-4xl">{{ heading }} <span class="text-ink-400">{{ heading_highlight }}</span></h1>
{% if supporting_text %}<p class="body-18 mt-8 max-w-xl text-ink-500">{{ supporting_text }}</p>{% endif %}
</section>
{% endif %}
