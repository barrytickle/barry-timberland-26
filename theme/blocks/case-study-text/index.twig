{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: works-details.html "The challenge" / "The outcome" sections.
   Paragraphs field is split on blank lines so editors can add more than one paragraph. #}
{% set heading = fields.heading %}
{% set paragraphs = fields.paragraphs|split("\n\n") %}

<section class="mx-auto max-w-[1200px] px-6 pb-8 lg:px-[72px] py-16" data-component="case-study-text">
	<div class="grid gap-10 lg:grid-cols-[0.6fr_1.4fr]">
		<h2 class="h4">{{ heading }}</h2>
		<div class="max-w-2xl">
			{% for paragraph in paragraphs %}
				<p class="body-18 {{ loop.first ? 'text-ink-600' : 'mt-5 text-ink-500' }}">{{ paragraph|nl2br }}</p>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}
