{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/stats.html #}
{% set stats = fields.stats|default([
	{ value: '8+', label: 'Years experience' },
	{ value: '120', label: 'Projects delivered' },
	{ value: '40', label: 'Happy clients' },
	{ value: '12', label: 'Awards won' }
]) %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="stats">
	<div class="grid grid-cols-2 gap-8 border-y border-ink-300 py-14 lg:grid-cols-4">
		{% for stat in stats %}
			<div><p class="h2">{{ stat.value }}</p><p class="body-16 mt-2 text-ink-500">{{ stat.label }}</p></div>
		{% endfor %}
	</div>
</section>
{% endif %}
