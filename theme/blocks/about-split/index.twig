<section id="{{ fields.anchor_id|default(block.anchor|default('')) }}" class="section-space bg-ink text-white">
  <div class="site-container grid items-center gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      {% include 'components/eyebrow.twig' with { text: fields.eyebrow|default(is_preview ? 'A little about me' : ''), class: 'text-violet-soft' } %}
      <h2 class="section-title mt-6 text-white">{{ fields.heading|default(is_preview ? 'Developer, problem solver and lifelong tinkerer.' : '') }}</h2>
      {% if fields.body %}<div class="body-large mt-7 max-w-2xl text-white/70">{{ fields.body|raw }}</div>{% endif %}
      {% if fields.interests %}<ul class="mt-8 grid gap-3 sm:grid-cols-2">{% for interest in fields.interests %}<li class="flex min-h-12 items-center gap-3 rounded-xl border border-white/15 px-4 py-3">{% include 'components/icon.twig' with { name: interest.icon } %}<span class="font-semibold">{{ interest.label }}</span></li>{% endfor %}</ul>{% endif %}
      {% if fields.link %}<div class="mt-8">{% include 'components/button.twig' with { link: fields.link, variant: 'violet', icon: 'arrow-right' } %}</div>{% endif %}
    </div>
    <div>{% include 'components/image.twig' with { image: fields.image, size: 'large', alt: fields.image.alt|default(''), class: 'aspect-[4/5] w-full rounded-[1.5rem] object-cover', is_preview: is_preview } only %}</div>
  </div>
</section>
