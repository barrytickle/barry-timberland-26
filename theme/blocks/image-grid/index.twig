{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: home-v2.html 3-up image row and works-details.html 2-up image row #}
{% set columns = fields.columns %}
{% set images = fields.images %}
{% set grid_class = columns == '2' ? 'sm:grid-cols-2' : 'sm:grid-cols-3' %}
{% set mockup_max_width = columns == '2' ? 'max-w-[420px]' : 'max-w-[280px]' %}

<section class="mx-auto max-w-[1200px] px-6 py-10 lg:px-[72px]" data-component="image-grid">
	<div class="grid grid-cols-1 items-start gap-6 {{ grid_class }}">
		{% for item in images %}
			{% include 'components/image-well.twig' with { image: item.image, logo: item.logo, mockup: item.mockup, aspect: 'aspect-square', mockup_max_width: mockup_max_width } %}
		{% endfor %}
	</div>
</section>
{% endif %}
