{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: home-v2.html 3-up image row and works-details.html 2-up image row #}
{% set columns = fields.columns|default('3') %}
{% set aspect = fields.aspect|default('aspect-[3/4]') %}
{% set images = fields.images|default([{}, {}, {}]) %}
{% set grid_class = columns == '2' ? 'sm:grid-cols-2' : 'sm:grid-cols-3' %}

<section class="mx-auto max-w-[1200px] px-6 py-10 lg:px-[72px]" data-component="image-grid">
	<div class="grid grid-cols-1 gap-6 {{ grid_class }}">
		{% for item in images %}
			<div class="grid {{ aspect }} place-items-center overflow-hidden rounded-card bg-muted">
				{% if item.image %}
					<img class="h-full w-full object-cover" src="{{ item.image.url }}" alt="{{ item.image.alt|default('') }}">
				{% else %}
					<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
				{% endif %}
			</div>
		{% endfor %}
	</div>
</section>
{% endif %}
