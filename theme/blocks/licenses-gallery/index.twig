{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/licenses-gallery.html #}
{% set heading = fields.heading|default("Imagery") %}
{% set description = fields.description|default("The images used in this website use free licenses on Unsplash and Pexels.") %}
{% set gallery_heading = fields.gallery_heading|default("Unsplash") %}
{% set gallery_url = fields.gallery_url|default("www.unsplash.com") %}
{% set placeholder_icon %}<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>{% endset %}

{% set items = fields.items|default([
	{ wrapper: 'row-span-2', aspect: 'aspect-[3/4]' },
	{ wrapper: '', aspect: 'aspect-[1/1]' },
	{ wrapper: '', aspect: 'aspect-[1/1]' },
	{ wrapper: 'col-span-2', aspect: 'aspect-[16/9]' }
]) %}

<section class="mx-auto max-w-[1200px] px-6 py-12 lg:px-[72px]" data-component="licenses-gallery">
	<h2 class="h4">{{ heading }}</h2>
	<p class="body-16 mt-3 text-ink-500">{{ description }}</p>
	<div class="mt-8">
		<div class="mb-5">
			<h3 class="h6">{{ gallery_heading }}</h3>
			<p class="body-14 text-ink-500">{{ gallery_url }}</p>
		</div>
		<div class="grid grid-cols-2 gap-4 md:grid-cols-3">
			{% for item in items %}
				{% set well %}
					<div class="grid {{ item.aspect }} place-items-center overflow-hidden rounded-card bg-muted">
						{% if item.image %}
							<img class="h-full w-full object-cover" src="{{ item.image.url }}" alt="{{ item.image.alt }}">
						{% else %}
							{{ placeholder_icon }}
						{% endif %}
					</div>
				{% endset %}
				{% if item.wrapper %}
					<div class="{{ item.wrapper }}">{{ well }}</div>
				{% else %}
					{{ well }}
				{% endif %}
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}
