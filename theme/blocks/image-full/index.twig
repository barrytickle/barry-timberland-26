{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: about-v2.html / blog-details.html / works-details.html full-width image wells #}
{% set image = fields.image %}
{% set width = fields.width|default('narrow') %}
{% set max_width = width == 'wide' ? 'max-w-[1200px] lg:px-[72px]' : 'max-w-[1040px]' %}

<section class="mx-auto {{ max_width }} px-6" data-component="image-full">
	{% if image %}
		<div class="aspect-[16/9] overflow-hidden rounded-card">
			<img class="h-full w-full object-cover" src="{{ image.url }}" alt="{{ image.alt|default('') }}">
		</div>
	{% else %}
		<div class="grid aspect-[16/9] place-items-center overflow-hidden rounded-card bg-muted">
			<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
		</div>
	{% endif %}
</section>
{% endif %}
