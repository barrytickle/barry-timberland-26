{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: about-v2.html / blog-details.html / works-details.html full-width image wells #}
{% set image = fields.image %}
{% set mockup = fields.mockup %}
{% set width = fields.width %}
{% set max_width = width == 'wide' ? 'max-w-[1200px] lg:px-[72px]' : 'max-w-[1040px]' %}

<section class="mx-auto {{ max_width }} px-6" data-component="image-full">
	{% include 'components/image-well.twig' with { image: image, mockup: mockup, aspect: 'aspect-[16/9]' } %}
</section>
{% endif %}
