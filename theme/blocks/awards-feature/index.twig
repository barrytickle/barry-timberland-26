{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{% import 'components/responsive-image.twig' as responsive_image %}
{% set image = fields.image %}
{% set heading = fields.heading %}
{% set credit = fields.credit %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="awards-feature">
	<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
		<div class="aspect-square overflow-hidden rounded-card bg-muted">
			{% if image %}
				{{ responsive_image.tag(image, { alt: image.alt, class: 'h-full w-full object-cover', sizes: '(min-width: 1024px) 50vw, 100vw' }) }}
			{% else %}
				<div class="grid h-full w-full place-items-center">
					<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
				</div>
			{% endif %}
		</div>
		<div>
			{% if heading %}<h2 class="h3">{{ heading }}</h2>{% endif %}
			{% if credit %}<p class="body-18 mt-5 text-ink-500">{{ credit|nl2br }}</p>{% endif %}
		</div>
	</div>
</section>
{% endif %}
