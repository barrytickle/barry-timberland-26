{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{% import 'components/responsive-image.twig' as responsive_image %}
{% set image = fields.image %}
{% set heading = fields.heading ?: 'My Promise to you' %}

<section class="promise-feature mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="awards-feature">
	<div class="promise-feature__layout grid items-stretch gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
		<div class="promise-feature__portrait overflow-hidden rounded-card bg-muted">
			{% if image %}
				{{ responsive_image.tag(image, { alt: image.alt, class: 'h-full w-full object-cover', sizes: '(min-width: 1024px) 42vw, 100vw' }) }}
			{% else %}
				<div class="grid h-full min-h-[28rem] w-full place-items-center">
					<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
				</div>
			{% endif %}
		</div>

		<div class="promise-feature__content flex flex-col justify-center">
			{% if heading %}
				<h2 class="promise-feature__heading h3">
					{% if heading|lower == 'my promise to you' %}
						<span class="block">My Promise</span>
						<span class="block text-ink-400">to you</span>
					{% else %}
						{{ heading }}
					{% endif %}
				</h2>
			{% endif %}

			<div class="promise-feature__grid mt-12 grid gap-4 sm:grid-cols-2">
				<article class="promise-feature__card">
					<div class="promise-feature__icon promise-feature__icon--blue" aria-hidden="true">
						<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
							<rect x="4" y="5" width="16" height="11" rx="1.5"></rect>
							<path d="M2.5 19h19"></path>
						</svg>
					</div>
					<h3 class="promise-feature__title">You own your website</h3>
					<p class="promise-feature__copy">Your domain, hosting and website access stay in your name.</p>
				</article>

				<article class="promise-feature__card">
					<div class="promise-feature__icon promise-feature__icon--violet" aria-hidden="true">
						<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
							<rect x="5" y="10" width="14" height="10" rx="2"></rect>
							<path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
						</svg>
					</div>
					<h3 class="promise-feature__title">No lock-in</h3>
					<p class="promise-feature__copy">If you ever want to move on, you can. I won't make your site depend on me just to keep it running.</p>
				</article>

				<article class="promise-feature__card">
					<div class="promise-feature__icon promise-feature__icon--teal" aria-hidden="true">
						<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
							<path d="M20 13 13 20 4 11V4h7l9 9Z"></path>
							<circle cx="8.5" cy="8.5" r="1"></circle>
						</svg>
					</div>
					<h3 class="promise-feature__title">Clear costs</h3>
					<p class="promise-feature__copy">You'll know what you're paying for before work starts, with no surprise extras.</p>
				</article>

				<article class="promise-feature__card">
					<div class="promise-feature__icon promise-feature__icon--amber" aria-hidden="true">
						<svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
							<path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 9.2 9.2 0 0 1-4-.9L3 21l1.6-4.3A8.2 8.2 0 0 1 3 11.5 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5Z"></path>
						</svg>
					</div>
					<h3 class="promise-feature__title">Straightforward support</h3>
					<p class="promise-feature__copy">I'll explain things clearly, keep you involved where it matters, and still be around if you need help after launch.</p>
				</article>
			</div>
		</div>
	</div>
</section>
{% endif %}
