{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/awards-list.html #}
{% set heading = fields.heading %}
{% set awards = fields.awards %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="awards-list">
	<div class="grid gap-10 lg:grid-cols-[0.9fr_1.6fr]">
		<h2 class="h3">{{ heading }}</h2>
		<div class="divide-y divide-ink-300 border-y border-ink-300">
			{% for award in awards %}
				<a class="group flex items-center justify-between gap-6 py-7" href="{{ award.href }}">
					<div><h4 class="h6 text-[1.5rem]">{{ award.title }}</h4><p class="body-16 mt-1 text-ink-500">{{ award.meta }}</p></div>
					<svg class="h-7 w-7 shrink-0 text-ink transition duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
				</a>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}