{% set surface = fields.background_style|default('paper') %}
{% set eyebrow = fields.eyebrow|default(fields.tag|default('')) %}
{% set heading = fields.heading|default(fields.title|default(is_preview ? 'Useful websites, thoughtfully built.' : post.title)) %}
{% set body = fields.body|default(fields.text|default('')) %}
{% set hero_image = fields.supporting_image|default(fields.image|default(null)) %}
{% set legacy_buttons = fields.buttons|default([]) %}
{% set primary_link = fields.primary_link|default(legacy_buttons[0].link|default(null)) %}
{% set secondary_link = fields.secondary_link|default(legacy_buttons[1].link|default(null)) %}
<section id="{{ fields.anchor_id|default(block.anchor|default('')) }}" class="section-space surface-{{ surface }} overflow-hidden">
  <div class="site-container-wide grid items-center gap-12 lg:grid-cols-[.78fr_1.22fr] lg:gap-20">
    <div class="relative z-10">
      {% include 'components/eyebrow.twig' with { text: eyebrow|default(is_preview ? 'Independent web developer' : '') } %}
      <h1 class="display-title mt-7">{{ heading }}</h1>
      {% if body %}<div class="body-large mt-7 max-w-2xl text-muted">{{ body|raw }}</div>{% endif %}
      <div class="mt-9 flex flex-wrap gap-3">
        {% include 'components/button.twig' with { link: primary_link, variant: 'violet', icon: 'arrow-right' } %}
        {% include 'components/button.twig' with { link: secondary_link, variant: 'outline' } %}
      </div>
      {% if fields.experience_note or fields.profile_image %}
        <div class="mt-10 flex items-center gap-4 border-t border-line pt-6">
          {% if fields.profile_image %}{% include 'components/image.twig' with { image: fields.profile_image, size: 'thumbnail', alt: fields.profile_image.alt|default(''), loading: 'eager', class: 'h-12 w-12 rounded-full object-cover' } only %}{% endif %}
          {% if fields.experience_note %}<p class="max-w-xs text-sm font-semibold leading-6 text-muted">{{ fields.experience_note }}</p>{% endif %}
        </div>
      {% endif %}
    </div>
    <div class="relative lg:-mr-[10vw]">
      <div class="absolute -inset-12 -z-10 rounded-full bg-violet-soft blur-3xl" aria-hidden="true"></div>
      {% include 'components/browser-frame.twig' with { image: hero_image, alt: fields.supporting_image_alt_override|default(hero_image.alt|default('')), label: fields.browser_label, loading: 'eager', fetchpriority: 'high', is_preview: is_preview } %}
    </div>
  </div>
</section>
