{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/testimonials-row.html #}
{% set heading = fields.heading %}
{% set testimonials = fields.testimonials %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="testimonials-row">
	<h2 class="h3 mb-10">{{ heading }}</h2>
	<div class="flex gap-6 overflow-x-auto pb-4 [scrollbar-width:none]">
		{% for t in testimonials %}
			<div class="w-[420px]">{% include 'components/testimonial-card.twig' with t %}</div>
		{% endfor %}
	</div>
</section>
{% endif %}
