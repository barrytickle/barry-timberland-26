{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: works.html filter pills #}
{% set tabs = fields.tabs|default([
	{ label: 'All', active: true },
	{ label: 'UIUX', active: false },
	{ label: 'Branding', active: false },
	{ label: 'Mobile App', active: false },
	{ label: 'Website Design', active: false }
]) %}

<section class="mx-auto max-w-[1200px] px-6 pb-8 lg:px-[72px]" data-component="work-filter-tabs">
	<div class="flex flex-wrap gap-3">
		{% for tab in tabs %}
			{% include 'components/button.twig' with { label: tab.label, variant: 'filter', active: tab.active } %}
		{% endfor %}
	</div>
</section>
{% endif %}
