{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/blog-list-row.html #}
{% set posts = fields.posts %}

<section class="mx-auto max-w-[1200px] px-6 py-8 lg:px-[72px]" data-component="blog-list-row">
<div class="divide-y divide-ink-200 border-y border-ink-200">
	{% for post in posts %}
		{% include 'components/blog-row-item.twig' with { title: post.title, date: post.date, excerpt: post.excerpt, tags: post.tags|split(',')|map(t => t|trim) } %}
	{% endfor %}
</div>
</section>
{% endif %}
