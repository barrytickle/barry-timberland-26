{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: detail_works.html work-details-gallery.
   A 2-up image row followed by a single full-width image — recurs consistently across case studies. #}
{% set top_images = fields.top_images %}
{% set bottom_image = fields.bottom_image %}

<section class="mx-auto max-w-[1200px] px-6 py-8 lg:px-[72px]" data-component="case-study-gallery">
	<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
		{% for item in top_images %}
			<div class="grid aspect-[4/3] place-items-center overflow-hidden rounded-card bg-muted">
				{% if item.image %}
					<img class="h-full w-full object-cover" src="{{ item.image.url }}" alt="{{ item.image.alt }}">
				{% else %}
					<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
				{% endif %}
			</div>
		{% endfor %}
	</div>
	<div class="mt-6 grid aspect-[16/9] place-items-center overflow-hidden rounded-card bg-muted">
		{% if bottom_image %}
			<img class="h-full w-full object-cover" src="{{ bottom_image.url }}" alt="{{ bottom_image.alt }}">
		{% else %}
			<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
		{% endif %}
	</div>
</section>
{% endif %}
