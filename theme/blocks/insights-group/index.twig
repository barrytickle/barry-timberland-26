{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: index.html / home-v2.html / home-v3.html "Insights" section #}
{% set heading = fields.heading %}
{% set cta = fields.cta_link %}
{% set articles = fields.articles %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="insights-group">
	{% include 'components/section-header.twig' with { heading: heading, link_href: cta.url, link_label: cta.title } %}
	<div class="grid gap-8 md:grid-cols-3">
		{% for article in articles %}
			{% include 'components/blog-card.twig' with { eyebrow: article.eyebrow, title: article.title, excerpt: article.excerpt, href: article.href, image: article.image } %}
		{% endfor %}
	</div>
</section>
{% endif %}
