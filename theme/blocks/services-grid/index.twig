{% set columns = fields.columns|default('2') %}
{% set services = fields.services|default(is_preview ? [
  { icon: 'code', heading: 'Front End Development', body: 'Fast, maintainable interfaces built around real content.' },
  { icon: 'flask', heading: 'CRO & Experimentation', body: 'Practical experiments informed by evidence.' },
  { icon: 'speedometer', heading: 'Performance Optimisation', body: 'Lean pages that feel quick on real devices.' },
  { icon: 'accessibility', heading: 'Accessibility', body: 'Inclusive interaction and sensible semantics.' }
] : []) %}
<section id="{{ fields.anchor_id|default(block.anchor|default('')) }}" class="section-space bg-white">
  <div class="site-container">
    <div class="max-w-4xl">
      {% include 'components/eyebrow.twig' with { text: fields.eyebrow|default(is_preview ? 'How I can help' : '') } %}
      <h2 class="section-title mt-5">{{ fields.heading|default(is_preview ? 'Digital work without the theatre.' : '') }}</h2>
      {% if fields.intro %}<div class="body-large mt-6 max-w-2xl text-muted">{{ fields.intro|raw }}</div>{% endif %}
    </div>
    <div class="mt-12 grid gap-px overflow-hidden rounded-2xl border border-line bg-line {{ columns == '4' ? 'md:grid-cols-2 xl:grid-cols-4' : (columns == '3' ? 'md:grid-cols-2 lg:grid-cols-3' : 'md:grid-cols-2') }}">
      {% for service in services %}
        <article class="bg-paper p-7 sm:p-9">
          <span class="grid h-12 w-12 place-items-center rounded-full bg-violet-soft text-violet-dark">{% include 'components/icon.twig' with { name: service.icon } %}</span>
          <h3 class="mt-8 text-2xl font-bold tracking-tight">{{ service.heading }}</h3>
          <div class="mt-4 leading-7 text-muted">{{ service.body|raw }}</div>
          {% if service.link %}<a class="mt-6 inline-flex min-h-11 items-center gap-2 font-bold text-violet-dark" href="{{ service.link.url }}">{{ service.link.title }} {% include 'components/icon.twig' with { name: 'arrow-right' } %}</a>{% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>
