{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Barry's Spectacular Site export: home-v3.html "Awards and recognition" dark row list #}
{% set eyebrow = fields.eyebrow %}
{% set awards = fields.awards %}

<section class="bg-ink text-white" data-component="awards-row-dark">
	<div class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]">
		<p class="body-14 font-semibold uppercase tracking-tightest text-white/50">{{ eyebrow }}</p>
		<div class="mt-8 divide-y divide-white/15">
			{% for award in awards %}
				<div class="grid grid-cols-[1fr_2fr_auto] items-center gap-4 py-6 body-16">
					<span class="text-white/70">{{ award.source }}</span>
					<strong class="font-semibold">{{ award.achievement }}</strong>
					<span class="text-white/50">{{ award.year }}</span>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}
