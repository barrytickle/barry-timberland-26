{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/testimonial-carousel.html #}
{% set testimonials = fields.testimonials|default([
	{ quote: "I had the pleasure of working with Ivan on a recent project, and I was blown away by their creativity and attention to detail. I highly recommend them for anyone looking for a talented and professional designer.", initials: 'RJ', name: 'Richard Jonas', role: 'CEO of Teamwork' },
	{ quote: "Ivan is an exceptionally talented designer who consistently exceeded our expectations, with designs that captured our brand's essence.", initials: 'RV', name: 'Rachel Voskov', role: 'CEO of Pipefy' },
	{ quote: "Working with Ivan was a game-changer for our business. His keen eye for detail enhanced the overall usability of our product.", initials: 'JM', name: 'Jacob McDany', role: 'CEO of Rackspace' }
]) %}

{% macro person(t) %}
	<blockquote class="mx-auto max-w-3xl h5 font-medium leading-snug">“{{ t.quote }}”</blockquote>
	<div class="mt-8 flex flex-col items-center">
		<span class="grid h-16 w-16 place-items-center rounded-full bg-ink-400 body-16 font-semibold text-white">{{ t.initials }}</span>
		<p class="mt-3 body-16 font-semibold">{{ t.name }}</p>
		<p class="body-14 text-ink-500">{{ t.role }}</p>
	</div>
{% endmacro %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]">
	{% if testimonials|length <= 1 %}
		<div class="text-center" data-component="testimonial-carousel">
			{% if testimonials|length %}{{ _self.person(testimonials[0]) }}{% endif %}
		</div>
	{% else %}
		<div class="swiper testimonial-carousel-swiper" data-component="testimonial-carousel">
			<div class="swiper-wrapper">
				{% for t in testimonials %}
					<div class="swiper-slide text-center">{{ _self.person(t) }}</div>
				{% endfor %}
			</div>
			<div class="swiper-pagination mt-10 static"></div>
		</div>
	{% endif %}
</section>
{% endif %}
