{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Desktop browser window chrome (traffic-light dots + URL bar) wrapped around a full website screenshot. #}
{% set image = fields.image %}
{% set url = fields.url %}
{% set width = fields.width %}
{% set max_width = width == 'narrow' ? 'max-w-[1040px]' : 'max-w-[1200px] lg:px-[72px]' %}

<section class="mx-auto {{ max_width }} px-6" data-component="browser-mockup">
	<div class="overflow-hidden rounded-card border border-ink-200 shadow-lg">
		<div class="flex items-center gap-5 border-b border-ink-200 bg-ink-100 px-5 py-3.5">
			<div class="flex shrink-0 gap-2">
				<span class="h-3 w-3 rounded-full" style="background-color:#FF5F57"></span>
				<span class="h-3 w-3 rounded-full" style="background-color:#FEBC2E"></span>
				<span class="h-3 w-3 rounded-full" style="background-color:#28C840"></span>
			</div>
			<div class="flex flex-1 justify-center">
				<div class="flex w-full max-w-md items-center gap-2 rounded-full bg-white px-4 py-1.5 text-ink-500">
					<svg class="h-3.5 w-3.5 shrink-0" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><rect height="11" rx="2" width="18" x="3" y="11"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
					<span class="truncate body-14">{{ url }}</span>
				</div>
			</div>
		</div>
		{% if image %}
			<img class="w-full" src="{{ image.url }}" alt="{{ image.alt }}">
		{% else %}
			<div class="grid aspect-[16/10] place-items-center bg-muted">
				<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
			</div>
		{% endif %}
	</div>
</section>
{% endif %}
