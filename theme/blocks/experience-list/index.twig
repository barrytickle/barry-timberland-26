{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/experience-list.html #}
{% set heading = fields.heading %}
{% set roles = fields.roles %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="experience-list">
	<div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
		<h2 class="h3">{{ heading }}</h2>
		<div class="border-t border-ink-300">
			{% for role in roles %}
				<div class="grid grid-cols-[1fr_auto] items-baseline gap-6 border-b border-ink-300 py-6">
					<div>
						<h4 class="body-22 font-semibold text-ink">{{ role.title }}</h4>
						<p class="body-16 mt-1 text-ink-500">{{ role.company }}</p>
					</div>
					<p class="body-16 text-ink-500">{{ role.dates }}</p>
				</div>
			{% endfor %}
		</div>
	</div>
</section>
{% endif %}
