{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{% set date = fields.date|default('') %}
{% set client_name = fields.client_name|default('') %}
{% set services = fields.services|default([]) %}
{% set website_link = fields.website_link|default({}) %}
{% set platform = fields.platform|default('WordPress') %}
{% set content = fields.content|default('') %}
{% set stats = fields.stats|default([]) %}
{% set journey_heading = fields.journey_heading|default('The project journey') %}
{% set journey_intro = fields.journey_intro|default('') %}
{# New ACF steps take precedence. Otherwise existing WYSIWYG headings form the timeline. #}
{% set manual_steps = fields.timeline_steps|default([]) %}
{% set timeline_steps = manual_steps ? manual_steps : case_study_sections(content) %}
{% set default_icons = ['alert-triangle', 'search', 'code', 'shield-check', 'chart'] %}
{% set available_icons = ['alert-triangle', 'search', 'code', 'shield-check', 'chart', 'calendar', 'user', 'settings', 'layers', 'clipboard', 'lightbulb', 'palette', 'monitor', 'check-circle', 'wrench', 'rocket', 'target', 'trending-up', 'database', 'refresh-cw'] %}
{% set sprite_id = 'cs-icons-' ~ block.id %}

<section class="case-study-body mx-auto max-w-[1200px] px-6 pb-12 lg:px-[72px]" data-component="case-study-body">
	{# Reusable, self-contained SVG sprite. No external icon font, images or JS required. #}
	<svg class="case-study-body__sprite" width="0" height="0" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg">
		<defs>
			<symbol id="{{ sprite_id }}-calendar" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></symbol>
			<symbol id="{{ sprite_id }}-user" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></symbol>
			<symbol id="{{ sprite_id }}-settings" viewBox="0 0 24 24"><path d="M9.7 3.5 10 2h4l.3 1.5 1.7.7 1.3-.9 2.8 2.8-.9 1.3.7 1.7L21.5 9v4l-1.6.3-.7 1.7.9 1.3-2.8 2.8-1.3-.9-1.7.7L14 20.5h-4l-.3-1.6-1.7-.7-1.3.9-2.8-2.8.9-1.3-.7-1.7L2.5 13V9l1.6-.3.7-1.7-.9-1.3 2.8-2.8 1.3.9z"/><circle cx="12" cy="11" r="3"/></symbol>
			<symbol id="{{ sprite_id }}-layers" viewBox="0 0 24 24"><path d="m12 3 9 5-9 5-9-5 9-5ZM3 12l9 5 9-5M3 16l9 5 9-5"/></symbol>
			<symbol id="{{ sprite_id }}-alert-triangle" viewBox="0 0 24 24"><path d="M10.3 3.8 2.5 18a2 2 0 0 0 1.7 3h15.6a2 2 0 0 0 1.7-3L13.7 3.8a2 2 0 0 0-3.4 0Z"/><path d="M12 9v5M12 18h.01"/></symbol>
			<symbol id="{{ sprite_id }}-search" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="7.3"/><path d="m16.2 16.2 5 5"/></symbol>
			<symbol id="{{ sprite_id }}-code" viewBox="0 0 24 24"><path d="m8 6-6 6 6 6m8-12 6 6-6 6m-3-16-2 20"/></symbol>
			<symbol id="{{ sprite_id }}-shield-check" viewBox="0 0 24 24"><path d="M12 2 20 5v6c0 5-3.2 8.6-8 11-4.8-2.4-8-6-8-11V5l8-3Z"/><path d="m8 12 2.5 2.5 5.5-5.5"/></symbol>
			<symbol id="{{ sprite_id }}-chart" viewBox="0 0 24 24"><path d="M4 20V12m5 8V7m5 13v-4m5 4V3"/></symbol>
			<symbol id="{{ sprite_id }}-clipboard" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="18" rx="2"/><rect x="9" y="2" width="6" height="4" rx="1"/><path d="M8 12h8M8 16h6"/></symbol>
			<symbol id="{{ sprite_id }}-lightbulb" viewBox="0 0 24 24"><path d="M9 18h6m-5 3h4M8 14a7 7 0 1 1 8 0l-1 4H9l-1-4Z"/></symbol>
			<symbol id="{{ sprite_id }}-palette" viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18h1a2 2 0 0 0 1.4-3.4 2 2 0 0 1 1.4-3.4H18A3 3 0 0 0 21 11a9 9 0 0 0-9-8Z"/><circle cx="7" cy="12" r="1"/><circle cx="10" cy="7.5" r="1"/><circle cx="16" cy="8" r="1"/></symbol>
			<symbol id="{{ sprite_id }}-monitor" viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="15" rx="2"/><path d="M8 22h8M12 18v4"/></symbol>
			<symbol id="{{ sprite_id }}-check-circle" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></symbol>
			<symbol id="{{ sprite_id }}-wrench" viewBox="0 0 24 24"><path d="M14.5 6.5a5 5 0 0 0-6.1 6.1L3 17.5A2.5 2.5 0 1 0 6.5 21l5.4-5.4a5 5 0 0 0 6.1-6.1l-3.5 3.5-3-3 3-3.5Z"/></symbol>
			<symbol id="{{ sprite_id }}-rocket" viewBox="0 0 24 24"><path d="M5 15c2.5-6.8 7.5-11 16-12-.8 8.5-5.2 13.5-12 16l-4-4Z"/><path d="m5 15-3 1 3-7 4-1m0 11-1 3 7-3 1-4"/><circle cx="15" cy="9" r="2"/></symbol>
			<symbol id="{{ sprite_id }}-target" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1"/></symbol>
			<symbol id="{{ sprite_id }}-trending-up" viewBox="0 0 24 24"><path d="m3 17 6-6 4 4 8-8M15 7h6v6"/></symbol>
			<symbol id="{{ sprite_id }}-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.7 4 3 9 3s9-1.3 9-3V5M3 12c0 1.7 4 3 9 3s9-1.3 9-3"/></symbol>
			<symbol id="{{ sprite_id }}-refresh-cw" viewBox="0 0 24 24"><path d="M20 7a8 8 0 0 0-14-1L3 9m0-6v6h6M4 17a8 8 0 0 0 14 1l3-3m0 6v-6h-6"/></symbol>
		</defs>
	</svg>

	<div class="case-study-body__meta" aria-label="Project details">
		{% if date %}
			<div class="case-study-body__meta-item">
				<span class="case-study-body__meta-icon" aria-hidden="true"><svg><use href="#{{ sprite_id }}-calendar"/></svg></span>
				<div class="case-study-body__meta-copy"><span class="case-study-body__meta-label">Date</span><span class="case-study-body__meta-value">{{ date|e }}</span></div>
			</div>
		{% endif %}
		{% if client_name %}
			<div class="case-study-body__meta-item">
				<span class="case-study-body__meta-icon" aria-hidden="true"><svg><use href="#{{ sprite_id }}-user"/></svg></span>
				<div class="case-study-body__meta-copy"><span class="case-study-body__meta-label">Client</span><span class="case-study-body__meta-value">{{ client_name|e }}</span></div>
			</div>
		{% endif %}
		{% if services %}
			<div class="case-study-body__meta-item">
				<span class="case-study-body__meta-icon" aria-hidden="true"><svg><use href="#{{ sprite_id }}-settings"/></svg></span>
				<div class="case-study-body__meta-copy">
					<span class="case-study-body__meta-label">Services</span>
					<span class="case-study-body__meta-value">{% for service in services %}{{ service.label|e }}{% if not loop.last %}, {% endif %}{% endfor %}</span>
				</div>
			</div>
		{% endif %}
		{% if platform %}
			<div class="case-study-body__meta-item">
				<span class="case-study-body__meta-icon" aria-hidden="true"><svg><use href="#{{ sprite_id }}-layers"/></svg></span>
				<div class="case-study-body__meta-copy"><span class="case-study-body__meta-label">Platform</span><span class="case-study-body__meta-value">{{ platform|e }}</span></div>
			</div>
		{% endif %}
	</div>

	{% if timeline_steps %}
		<div class="case-study-body__heading">
			<h2>{{ journey_heading|e }}</h2>
			{% if journey_intro %}<p>{{ journey_intro|e }}</p>{% endif %}
		</div>
		<ol class="case-study-body__timeline">
			{% for step in timeline_steps %}
				{% set selected_icon = step.icon|default('') %}
				{% set icon = selected_icon in available_icons ? selected_icon : default_icons[loop.index0 % 5] %}
				<li class="case-study-body__step">
					<div class="case-study-body__step-badge" aria-hidden="true">
						<svg><use href="#{{ sprite_id }}-{{ icon }}"/></svg>
					</div>
					<div class="case-study-body__step-card">
						{% if step.title %}<h3>{{ step.title|e }}</h3>{% endif %}
						{% if step.description %}
							<div class="case-study-body__step-content">{{ step.description|strip_wp_classes }}</div>
						{% endif %}
					</div>
				</li>
			{% endfor %}
		</ol>
	{% endif %}

	{% if stats %}
		<div class="case-study-body__results" aria-label="Project highlights">
			{% for stat in stats %}
				<div class="case-study-body__result">
					<strong>{{ stat.value|e }}</strong>
					<span>{{ stat.label|e }}</span>
				</div>
			{% endfor %}
		</div>
	{% endif %}
	{% if website_link.url %}
		<div class="case-study-body__website">
			{% include 'components/button.twig' with { href: website_link.url, label: website_link.title ?: 'View website', target: website_link.target, variant: 'outlined', size: 'sm' } %}
		</div>
	{% endif %}
</section>
{% endif %}
