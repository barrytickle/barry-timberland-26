{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Two independent content columns, side by side. #}
{% set eyebrow = fields.eyebrow %}
{% set column_one = fields.column_one %}
{% set column_two = fields.column_two %}
{% set columns = [column_one, column_two] %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="split-content">
	{% if eyebrow %}<p class="body-14 font-semibold uppercase tracking-tightest text-ink-500">{{ eyebrow }}</p>{% endif %}
	<div class="{{ eyebrow ? 'mt-8' : '' }} grid gap-10 lg:grid-cols-2 lg:gap-16">
		{% for column in columns %}
			<div class="{{ not loop.first ? 'lg:border-l lg:border-ink-300 lg:pl-16' : '' }}">
				{% if column.heading %}<h2 class="h4">{{ column.heading }}</h2>{% endif %}
				{% if column.body %}
					{% set column_body = column.body %}
					{% if post.post_name == 'about-me' %}
						{# Links the existing "Oswestry, Shropshire" mention to the dedicated
						   local-SEO page, at render time rather than stored HTML — see
						   hero/index.twig for why (WPVibe's editor rejects angle brackets
						   inside a block's stored JSON attributes). #}
						{% set column_body = column_body|replace({
							'Oswestry, Shropshire': '<a href="' ~ site.url ~ '/web-developer-oswestry/" class="underline decoration-ink-300 underline-offset-4 hover:text-ink">Oswestry, Shropshire</a>'
						}) %}
					{% endif %}
					<p class="body-18 {{ column.heading ? 'mt-5' : '' }} text-ink-500">{{ column_body|nl2br }}</p>
				{% endif %}
				{% if column.cta_link.url %}
					<div class="mt-6">{% include 'components/button.twig' with { href: column.cta_link.url, label: column.cta_link.title, target: column.cta_link.target, variant: 'text' } %}</div>
				{% endif %}
			</div>
		{% endfor %}
	</div>
</section>
{% endif %}
