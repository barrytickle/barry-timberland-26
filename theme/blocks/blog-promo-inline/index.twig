{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Horizontal image-left/text-right card for cross-promoting an article mid-content. #}
{% import 'components/responsive-image.twig' as responsive_image %}
{% set image = fields.image %}
{% set title = fields.title %}
{% set excerpt = fields.excerpt %}
{% set href = fields.link.url %}

<a class="group mx-auto grid max-w-[1200px] gap-6 px-6 py-4 sm:grid-cols-[220px_1fr] lg:px-[72px]" data-component="blog-promo-inline" href="{{ href }}"{% if fields.link.target %} target="{{ fields.link.target }}"{% endif %}>
	<div class="grid aspect-[4/3] place-items-center overflow-hidden rounded-card bg-muted">
		{% if image %}
			{{ responsive_image.tag(image, { class: 'h-full w-full object-cover transition duration-200 group-hover:scale-105', sizes: '(min-width: 640px) 220px, 100vw' }) }}
		{% else %}
			<svg class="h-10 w-10 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
		{% endif %}
	</div>
	<div class="flex flex-col justify-center">
		<h3 class="h6 transition duration-200 group-hover:text-ink-600">{{ title }}</h3>
		<p class="body-16 mt-3 text-ink-500">{{ excerpt }}</p>
	</div>
</a>
{% endif %}
