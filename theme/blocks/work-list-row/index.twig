{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/work-list-row.html #}
{% import 'components/responsive-image.twig' as responsive_image %}
{% set items = fields.items %}

<section class="mx-auto max-w-[1200px] px-6 py-8 lg:px-[72px]" data-component="work-list-row">
	<div class="divide-y divide-ink-300 border-y border-ink-300">
		{% for item in items %}
			<a class="group relative grid grid-cols-1 items-center gap-4 py-8 md:grid-cols-[300px_1fr_auto]" href="{{ item.href }}">
				<div>
					<h4 class="h6 text-[1.5rem]">{{ item.title }}</h4>
					<p class="body-16 mt-1 text-ink-500">{{ item.date }}</p>
				</div>
				<p class="body-16 max-w-md text-ink-600">{{ item.description }}</p>
				{% include 'components/tag-list.twig' with { tags: item.tags|split(',')|map(t => t|trim) } %}
				{% if item.image %}
					<div class="pointer-events-none absolute right-0 top-1/2 z-10 hidden aspect-[4/3] w-64 -translate-y-1/2 overflow-hidden rounded-card opacity-0 shadow-lg transition duration-200 group-hover:opacity-100 lg:block">
						{{ responsive_image.tag(item.image, { class: 'h-full w-full object-cover', sizes: '256px' }) }}
					</div>
				{% endif %}
			</a>
		{% endfor %}
	</div>
</section>
{% endif %}
