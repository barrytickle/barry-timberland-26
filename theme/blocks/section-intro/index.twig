{% set alignment = fields.alignment|default('split') %}
<section id="{{ fields.anchor_id|default(block.anchor|default('')) }}" class="section-space-sm">
  <div class="site-container {{ alignment == 'centre' ? 'text-center' : '' }}">
    <div class="{{ alignment == 'split' ? 'grid gap-7 lg:grid-cols-2 lg:items-start' : (alignment == 'centre' ? 'mx-auto max-w-4xl' : 'max-w-4xl') }}">
      <div>
        {% include 'components/eyebrow.twig' with { text: fields.eyebrow|default(is_preview ? 'Selected work' : '') } %}
        <h2 class="section-title {{ alignment == 'centre' ? 'mx-auto' : '' }} mt-5">{{ fields.heading|default(is_preview ? 'Work built to be clear, quick and useful.' : '') }}</h2>
      </div>
      {% if fields.body %}<div class="body-large {{ alignment == 'split' ? 'lg:pt-8' : 'mt-7' }} text-muted">{{ fields.body|raw }}</div>{% endif %}
    </div>
  </div>
</section>
