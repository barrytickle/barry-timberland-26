{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/clients-list.html #}
{% set heading = fields.heading|default("Clients") %}
{% set clients = fields.clients|default([
	{ name: 'Teamwork.inc', date: 'May 5, 2023', wordmark: 'teamwork.', href: '#' },
	{ name: 'Django', date: 'May 5, 2023', wordmark: 'django', href: '#' },
	{ name: 'Pipefy.io', date: 'May 5, 2023', wordmark: 'pipefy', href: '#' },
	{ name: 'Rackspace', date: 'May 5, 2023', wordmark: 'rackspace.', href: '#' }
]) %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="clients-list">
	<h2 class="h3 mb-10">{{ heading }}</h2>
	<div class="divide-y divide-ink-300 border-y border-ink-300">
		{% for client in clients %}
			<a class="group flex items-center justify-between gap-6 py-6" href="{{ client.href }}">
				<div><h4 class="h6 text-[1.35rem]">{{ client.name }}</h4><p class="body-14 mt-1 text-ink-500">{{ client.date }}</p></div>
				<div class="flex items-center gap-8">
					<span class="body-22 font-semibold text-ink-400">{{ client.wordmark }}</span>
					<svg class="h-6 w-6 text-ink transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
				</div>
			</a>
		{% endfor %}
	</div>
</section>
{% endif %}
