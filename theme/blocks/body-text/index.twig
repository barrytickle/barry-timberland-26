{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{% set content = fields.content|default('') %}
{% set is_article = fields.is_article|default(false) %}
{% set section_spacing = is_article ? 'px-4 py-10 sm:px-5 lg:py-14' : 'px-6 py-12 lg:px-[72px] lg:py-16' %}
{% set content_width = is_article ? 'article-prose mx-auto max-w-[72ch]' : 'w-full' %}

<section class="mx-auto max-w-[1200px] {{ section_spacing }}" data-component="body-text">
	<div class="rich-text-content {{ content_width }}">
		{{ content|strip_wp_classes }}
	</div>
</section>
{% endif %}
