{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/hero.html #}
{% set eyebrow = fields.eyebrow %}
{% set heading = fields.heading %}
{% set heading_highlight = fields.heading_highlight %}
{% set cta = fields.cta_link %}
{% set supporting_text = fields.supporting_text %}
{% set text_alignment = fields.text_alignment %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px] lg:py-24" data-component="hero">
	<p class="body-22 mb-6 text-ink-700">{{ eyebrow }}</p>
	<h1 class="h1 max-w-5xl">{{ heading }} 
	{% if heading_highlight %}
		<span class="text-ink-400">{{ heading_highlight }}</span>
	{% endif %}
	</h1>
	<div class="mt-12 flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
		{% if cta %}
			{% include 'components/button.twig' with { href: cta.url, label: cta.title, target: cta.target, variant: 'filled', size: 'lg' } %}
		{% endif %}
		<p class="body-18 max-w-md text-ink-600 lg:{{ text_alignment }}">{{ supporting_text }}</p>
	</div>
</section>
{% endif %}
