{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/not-found.html #}
{% set heading_highlight = fields.heading_highlight %}
{% set heading = fields.heading %}
{% set body = fields.body %}
{% set cta = fields.cta_link %}

<section class="mx-auto flex max-w-[1200px] flex-col items-center px-6 py-28 text-center lg:px-[72px]" data-component="not-found">
	<h1 class="h1"><span class="text-ink-400">{{ heading_highlight }}</span> {{ heading }}</h1>
	<p class="body-22 mt-6 text-ink-500">{{ body }}</p>
	<div class="mt-10">
		{% include 'components/button.twig' with { href: cta.url, label: cta.title, target: cta.target, variant: 'filled', size: 'lg' } %}
	</div>
</section>
{% endif %}
