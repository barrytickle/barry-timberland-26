{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: about-v2.html intro-with-stats section #}
{% set heading = fields.heading %}
{% set body = fields.body %}
{% set stats = fields.stats %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="intro-with-stats">
	<div class="grid gap-10 lg:grid-cols-2">
		<h2 class="h3">{{ heading }}</h2>
		<p class="body-18 self-center text-ink-500">{{ body }}</p>
	</div>
	<div class="mt-14 grid grid-cols-1 gap-8 border-t border-ink-300 pt-12 sm:grid-cols-3" data-component="stats">
		{% for stat in stats %}
			<div class="text-center lg:text-left">
				{% if stat.year_range %}<p class="body-14 font-semibold uppercase tracking-tightest text-ink-400">{{ stat.year_range }}</p>{% endif %}
				<p class="h2 {{ stat.year_range ? 'mt-1' : '' }}">{{ stat.value }}</p>
				<p class="body-16 mt-2 text-ink-500">{{ stat.label }}</p>
			</div>
		{% endfor %}
	</div>
</section>
{% endif %}
