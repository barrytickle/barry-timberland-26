{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# MacBook Pro frame PNG with a transparent screen cutout; screenshot is positioned behind it. #}
{% set image = fields.image %}
{% set width = fields.width %}
{% set max_width = width == 'narrow' ? 'max-w-[1040px]' : 'max-w-[1200px] lg:px-[72px]' %}
{% set frame_src = theme.link ~ '/assets/images/macbook-pro-mockup.png' %}

<section class="mx-auto {{ max_width }} px-6" data-component="macbook-mockup">
	<div class="relative mx-auto aspect-square w-full max-w-[900px]">
		<div class="absolute overflow-hidden rounded-[1.5%]" style="left:9.5%;top:21.9%;width:80.9%;height:52%">
			{% if image %}
				<img class="h-full w-full object-cover object-top" src="{{ image.url }}" alt="{{ image.alt }}">
			{% else %}
				<div class="grid h-full w-full place-items-center bg-ink-950">
					<svg class="h-10 w-10 text-ink-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
				</div>
			{% endif %}
		</div>
		<img class="pointer-events-none relative z-10 w-full select-none" src="{{ frame_src }}" alt="" aria-hidden="true">
	</div>
</section>
{% endif %}
