{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{% set image = fields.image %}
{% set width = fields.width %}
{% set section_width = width == 'narrow' ? 'max-w-[1040px]' : 'max-w-[1200px] lg:px-[72px]' %}

<section class="mx-auto {{ section_width }} px-6">
	{% include 'components/image-well.twig' with { image: image, mockup: true } %}
</section>
{% endif %}
