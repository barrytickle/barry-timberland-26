{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: about.html bio section #}
{% set image = fields.image %}
{% set paragraph_1 = fields.paragraph_1 %}
{% set paragraph_2 = fields.paragraph_2 %}
{% set cta = fields.cta_link %}

<section class="mx-auto max-w-[1200px] px-6 py-12 lg:px-[72px]" data-component="bio-text">
	<div class="grid gap-10 lg:grid-cols-2">
		{% if image %}
			<div class="aspect-[4/5] overflow-hidden rounded-card">
				<img class="h-full w-full object-cover" src="{{ image.url }}" alt="{{ image.alt }}">
			</div>
		{% else %}
			<div class="grid aspect-[4/5] place-items-center overflow-hidden rounded-card bg-muted">
				<svg class="h-12 w-12 text-ink-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect height="18" rx="2" width="18" x="3" y="3"></rect><circle cx="9" cy="9" r="2"></circle><path d="m21 15-3.5-3.5a2 2 0 0 0-3 0L5 21"></path></svg>
			</div>
		{% endif %}
		<div class="flex flex-col justify-center">
			<p class="body-18 text-ink-600">{{ paragraph_1 }}</p>
			<p class="body-18 mt-5 text-ink-500">{{ paragraph_2 }}</p>
			<div class="mt-8">{% include 'components/button.twig' with { href: cta.url, label: cta.title, target: cta.target, variant: 'outlined', size: 'md' } %}</div>
		</div>
	</div>
</section>
{% endif %}
