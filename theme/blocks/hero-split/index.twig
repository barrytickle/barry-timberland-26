{% if is_preview and preview_image %}
	<img src="{{ preview_image }}" alt="{{ block.title|default('Block') }} preview" loading="lazy" style="max-width:100%;">
{% else %}
{# Converted from Showcasy UI kit: components/hero-split.html #}
{% set heading = fields.heading|default("I’m a visual designer with passion to create") %}
{% set heading_highlight = fields.heading_highlight|default("a great experiences") %}
{% set supporting_text = fields.supporting_text|default("I’m Ivan, a Visual Designer living in Munich, and I focus on making digital experiences that are easy to use, enjoyable, and get the job done.") %}
{% set cta = fields.cta_link|default({ url: site.url ~ '/contact/', title: 'Let’s Talk' }) %}
{% set social_links = fields.social_links|default([
	{ label: 'Instagram', href: '#' },
	{ label: 'Behance', href: '#' },
	{ label: 'Dribbble', href: '#' }
]) %}

<section class="mx-auto max-w-[1200px] px-6 py-16 lg:px-[72px]" data-component="hero-split">
	<h1 class="h1 max-w-5xl">{{ heading }} <span class="text-ink-400">{{ heading_highlight }}</span></h1>
	<div class="mt-12 grid items-end gap-8 lg:grid-cols-2">
		<div class="flex flex-wrap gap-8">
			{% for link in social_links %}
				<a class="group inline-flex items-center gap-1.5 body-14 font-semibold text-ink hover:text-ink-500" href="{{ link.href }}">{{ link.label|upper }}
					<svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24"><path d="M7 17 17 7"></path><path d="M7 7h10v10"></path></svg>
				</a>
			{% endfor %}
		</div>
		<div class="lg:justify-self-end lg:text-right">
			<p class="body-18 max-w-md text-ink-600">{{ supporting_text }}</p>
			<div class="mt-6 flex lg:justify-end">
				{% include 'components/button.twig' with { href: cta.url, label: cta.title, target: cta.target, variant: 'filled', size: 'lg' } %}
			</div>
		</div>
	</div>
</section>
{% endif %}
